{
  "name": "nodejs-course-chapter-11",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "check": "npm run generate && npm run typecheck && npm test && npm run build && npm run test:runtime",
    "test:runtime": "node scripts/check-database-runtime.cjs",
    "seed": "node dist/generate-export.js",
    "encoding": "node dist/encoding-demo.js",
    "files": "node dist/files-demo.js",
    "lab": "node dist/middleware-lab.js",
    "generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node dist/seed-database.js"
  },
  "devDependencies": {
    "@jest/globals": "30.2.0",
    "@types/node": "24.19.2",
    "jest": "30.2.0",
    "typescript": "5.9.3",
    "@types/express": "5.0.6",
    "supertest": "7.3.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "@types/pg": "8.23.1"
  },
  "dependencies": {
    "express": "5.3.0",
    "zod": "4.6.7",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1"
  }
}
