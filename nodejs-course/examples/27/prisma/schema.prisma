generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
enum ArticleStatus {
  draft
  published
  archived
}
enum UserRole {
  member
  admin
}
model User {
  id String @id
  displayName String
  email String? @unique
  passwordHash String?
  role UserRole @default(member)
  articles Article[]
  sessions Session[]
  articleStatusAudits ArticleStatusAudit[]
}
model Session {
  tokenHash String @id @db.Char(64)
  csrfToken String @db.VarChar(43)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([userId])
}
model Article {
  id String @id @default(uuid())
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title String
  content String
  status ArticleStatus @default(draft)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  statusAudits ArticleStatusAudit[]

  @@index([status, createdAt, id])
  @@index([authorId, createdAt, id])
}

// 僅記錄本章啟用後的 publish／archive；不複製正文、Session 或憑證。
enum ArticleStatusAction {
  publish
  archive
}
model ArticleStatusAudit {
  id String @id
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action ArticleStatusAction
  fromStatus ArticleStatus
  toStatus ArticleStatus
  fromVersion Int
  toVersion Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([articleId, toVersion])
  @@index([actorId, createdAt])
}
