{
  "name": "typescript-demo",
  "private": true,
  "version": "1.0.0",
  "description": "TypeScript 課程測試環境：快速執行與型別檢查任何 .ts 檔案",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/playground.ts",
    "start": "tsx src/playground.ts",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "capi": "tsx src/compiler-api.ts"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
