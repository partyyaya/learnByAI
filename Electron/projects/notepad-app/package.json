{
  "name": "electron-notepad",
  "productName": "記事本",
  "version": "1.0.0",
  "description": "Electron 課程實戰專案：本機記事本（左側清單 + 右側撰寫區）",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "node scripts/rename-dev-app.js && electron .",
    "icon": "electron scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "notepad"
  ],
  "author": "learnbyai",
  "license": "MIT",
  "build": {
    "appId": "com.learnbyai.notepad",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
